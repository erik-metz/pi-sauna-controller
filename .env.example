# Copy to .env. Never commit the actual .env file.
# Quote passwords containing spaces or #. No shell evaluation/interpolation occurs.
MQTT_HOST="homeassistant.local"
MQTT_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TLS=false
MQTT_CA_FILE=""
GITHUB_REPOSITORY="owner/pi-sauna-controller"

# Private RSA signing key, encoded as one base64 line. Keep only on developer PC / CI.
# The installer NEVER transfers this variable to the Pi.
RELEASE_SIGNING_KEY_B64=""
